{
  "name": "league-profile-tool",
  "version": "3.6.1",
  "description": "Tool that interacts with the Riot LCU",
  "homepage": "https://github.com/VeryVeryCoolName/league-profile-tool",
  "author": "VeryVeryCoolName",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync:version": "node scripts/sync-version.js",
    "verify:assets": "node scripts/verify-assets.js",
    "postinstall": "node scripts/ensure-electron.mjs",
    "ng": "ng",
    "start": "npm run sync:version && npm-run-all -p electron:serve ng:serve:raw",
    "typecheck:app": "node node_modules/typescript/bin/tsc -p src/tsconfig.app.json --noEmit",
    "typecheck:electron": "node node_modules/typescript/bin/tsc -p tsconfig.serve.json --noEmit",
    "typecheck": "npm-run-all -s typecheck:app typecheck:electron",
    "compile:electron": "node node_modules/typescript/bin/tsc -p tsconfig.serve.json",
    "build": "npm run sync:version && npm run verify:assets && npm run compile:electron && cross-env NODE_OPTIONS=--no-deprecation ng build --base-href ./ && node scripts/inject-modulepreload.js",
    "build:dev": "npm run sync:version && npm run verify:assets && npm run compile:electron && cross-env NODE_OPTIONS=--no-deprecation ng build --base-href ./ -c dev && node scripts/inject-modulepreload.js",
    "build:prod": "npm run sync:version && npm run verify:assets && npm run compile:electron && cross-env NODE_OPTIONS=--no-deprecation ng build --base-href ./ -c production && node scripts/inject-modulepreload.js",
    "build:run": "npm run build:prod && electron .",
    "ng:serve": "npm run sync:version && npm run ng:serve:raw",
    "ng:serve:raw": "cross-env NODE_OPTIONS=--no-deprecation ng serve -c web",
    "electron:serve-tsc": "npm run compile:electron",
    "electron:serve": "wait-on tcp:4200 && npm run compile:electron && electron . --serve",
    "electron:local": "npm run build:prod && electron .",
    "electron:package": "electron-builder build --publish=never",
    "electron:build": "npm run build:prod && npm run electron:package",
    "electron:package:store": "electron-builder build --win appx --publish=never",
    "electron:build:store": "npm run build:prod && npm run electron:package:store",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\" \"main.ts\" \"preload.ts\"",
    "verify": "npm-run-all -s lint typecheck test build:prod",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.veryverycoolname.leagueprofiletool",
    "productName": "League Profile Tool",
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "Utility"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "version.json",
      "dist/**/*",
      "!dist/appx/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "dist"
    },
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": "VeryVeryCoolName"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "differentialPackage": false
    },
    "appx": {
      "displayName": "League Profile Tool",
      "identityName": "VeryVeryCoolName.LeagueProfileTool",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0",
      "publisher": "CN=9DC3397F-BC87-4541-83D2-8175D1471425",
      "publisherDisplayName": "VeryVeryCoolName",
      "applicationId": "LeagueProfileTool",
      "backgroundColor": "#111820",
      "artifactName": "${productName} ${version}.msix"
    },
    "extraFiles": [
      "config"
    ]
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/animations": "22.0.7",
    "@angular/build": "22.0.7",
    "@angular/cdk": "22.0.5",
    "@angular/cli": "22.0.7",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/language-service": "22.0.7",
    "@angular/material": "22.0.5",
    "@angular/platform-browser": "22.0.7",
    "@electron-internal/extract-zip": "1.0.4",
    "@eslint/js": "10.0.1",
    "@types/jasmine": "6.0.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.7.0",
    "jasmine-core": "6.3.0",
    "karma": "6.4.4",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "npm-run-all": "4.1.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "wait-on": "9.1.0",
    "zone.js": "0.16.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "browserslist": [
    "chrome 150"
  ],
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.0.11",
    "esbuild": "0.28.1",
    "piscina": "5.2.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.5.6": true
  }
}
